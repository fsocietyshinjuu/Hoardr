{
  "name": "hoardr",
  "version": "1.1.0",
  "description": "Desktop app to download public media from social profiles, powered by gallery-dl and yt-dlp.",
  "main": "src/main.js",
  "author": "Shinjuu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.hoardr",
    "productName": "Hoardr",
    "files": ["src/**/*", "package.json"],
    "extraResources": [{ "from": "bin", "to": "bin", "filter": ["**/*"] }],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities" },
    "linux": { "target": ["AppImage", "deb"], "category": "Utility" },
    "artifactName": "Hoardr-${version}-${os}-${arch}.${ext}"
  }
}
