{
  "name": "Hoardr",
  "version": "1.0.0",
  "description": "Desktop app to download public media from social profiles, powered by gallery-dl and yt-dlp.",
  "main": "src/main.js",
  "homepage": "https://github.com/fsocietyshinjuu/Hoardr",
  "author": { "name": "fsocietyshinjuu", "email": "noreply@users.noreply.github.com" },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fsocietyshinjuu.Hoardr",
    "productName": "Hoardr",
    "files": ["src/**/*", "package.json"],
    "extraResources": [{ "from": "bin", "to": "bin", "filter": ["**/*"] }],
    "artifactName": "Hoardr-${version}-${os}-${arch}.${ext}",
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "artifactName": "Hoardr-Setup-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "Hoardr-Portable-${version}-${arch}.${ext}" },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities", "identity": null },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "maintainer": "fsocietyshinjuu <noreply@users.noreply.github.com>"
    }
  }
}
