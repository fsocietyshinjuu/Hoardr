{
  "name": "hoardr",
  "productName": "Hoardr",
  "version": "1.1.0",
  "description": "Desktop app to download public media from social profiles, powered by gallery-dl and yt-dlp.",
  "main": "src/main.js",
  "homepage": "https://github.com/fsocietyshinjuu/Hoardr",
  "author": {
    "name": "fsocietyshinjuu",
    "email": "noreply@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fsocietyshinjuu.hoardr",
    "files": [
      "src/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fsocietyshinjuu",
        "repo": "Hoardr",
        "releaseType": "release"
      }
    ],
    "artifactName": "Hoardr-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Hoardr-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Hoardr-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "fsocietyshinjuu <noreply@users.noreply.github.com>",
      "icon": "build/icon.png"
    }
  }
}